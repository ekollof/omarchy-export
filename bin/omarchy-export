#!/usr/bin/env python3
import sys
from pathlib import Path

for root in (
    Path(__file__).resolve().parent.parent,
    Path(__file__).resolve().parent.parent / "lib" / "omarchy-export",
    Path.home() / ".local" / "lib" / "omarchy-export",
    Path("/usr/lib/omarchy-export"),
):
    if (root / "omarchy_export" / "__init__.py").is_file():
        sys.path.insert(0, str(root))
        break

from omarchy_export.cli import main

sys.exit(main())
